#The three inputs are employee name, hours worked, and amount of dependents
employee_name = input("""Employee's name:""")
hours_worked = int(input('Number of Hours worked in a week: '))
if (hours_worked > 40):
    overtime_hours = hours_worked - 40
    overtime_pay = overtime_hours * 10.78
    gross_income = (hours_worked * 16.78) + overtime_pay
else:
    overtime_hours = 0
    gross_income = hours_worked * 16.78
dependents = int(input('How many dependents the worker has: '))
state_tax = gross_income * 0.05
federal_tax = gross_income * 0.14
if(dependents <= 2):
    insurance = 60
else:
    insurance = insurance = (35 * (dependents-2)) + 60
net_pay = gross_income - state_tax - federal_tax - insurance
print('-------------------------------------------')
print("""Employee's Name:"""," ", " "," "," "," "," ",employee_name)
print('Number of Dependents:', " ", " "," "," "," "," "," ",dependents)
print('Hours worked:', " ", " "," ", " "," ", " "," "," "," "," ","",hours_worked)
print('Overtime hours:', " ", " "," ", " "," "," "," "," "," "," ",overtime_hours)
print(f'Gross Income: {" "}{" "}{" "}{" "}{" "}{" "}{" "}{" "}{" "}{" "}{" "}{" "}{" "}{" "}{" "}{" "}{" "}{" "}{" "}{" "}${gross_income:.2f}')
print(f'State Tax Withheld @ 5%: {" "}{" "}{" "}{" "}{" "}{" "}{" "}{" "}{" "}{" "}${state_tax:.2f}')
print(f'Federal Tax Withhled @ 14%: {" "}{" "}{" "}{" "}{" "}{" "}${federal_tax:.2f}')
print(f'Worker and Dependent Insurance: {" "}{" "}${insurance:.2f}')
print('-------------------------------------------')
print(f'Net Home Pay: {" "}{" "}{" "}{" "}{" "}{" "}{" "}{" "}{" "}{" "}{" "}{" "}{" "}{" "}{" "}{" "}{" "}{" "}{" "}{" "}${net_pay:.2f}')
