Player_win_count = 0
Computer_win_count = 0

for i in range(0,10):
    Player = getUserChoice()
    CPU = getComputerChoice()
    
    while Player == CPU:
        print('Tie')
        print( )
        Player = getUserChoice()
        CPU = getComputerChoice()
    
    Results = determineWinner(Player, CPU)
    
    if Results == 'U':
        Player_win_count += 1
    elif Results == 'C':
